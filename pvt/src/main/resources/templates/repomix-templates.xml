                + Thêm mới công việc
            </button>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="table-responsive mb-4">
            <table class="table table-hover table-bordered bg-white m-0" th:if="${monthEventList != null}">
                <thead class="table-light">
                <tr>
                    <th class="text-center">STT</th>
                    <th style="min-width: 200px;">Nội dung giao việc</th>
                    <th class="text-center" style="min-width: 150px;">Deadline</th>
                    <th class="text-center" style="min-width: 180px;">Hành động</th>
                </tr>
                </thead>
                <tbody>
                <tr th:each="list,iter: ${monthEventList}" class="align-middle">
                    <td class="text-center fw-bold text-muted" th:text="${iter.count}"></td>
                    <td class="text-start" th:text="${list.getMonthEventDescription()}"></td>
                    <td class="text-center fw-bold text-danger" th:text="${list.getFormattedDeadlineByFormat()}"></td>
                    <td class="text-center">
                        <!-- Gom nhóm các nút bấm -->
                        <div class="action-buttons">
                            <!-- Sửa -->
                            <a th:href="@{/home/manager/task/showEditMonthEventForm/{id} (id=${list.getMonthEventId()})}" class="btn btn-sm btn-outline-secondary">
                                Sửa
                            </a>
                            
                            <!-- Xóa -->
                            <a th:href="@{/home/manager/weeklyTask/delete/{id} (id=${list.getMonthEventId()})}" 
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa công việc này?');">
                                Xóa
                            </a>
                            
                            <!-- Ẩn / Hiện -->
                            <form th:action="@{/home/manager/task/toggleHidden/{id}(id=${list.monthEventId})}" method="post" style="margin: 0;">
    				<button type="submit" class="btn btn-sm"
            				th:classappend="${list.hidden} ? 'btn-success' : 'btn-warning'"
            				th:text="${list.hidden} ? 'Hiện việc' : 'Ẩn việc'">
    				</button>
			    </form>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- Phân trang và Nút trở về -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            
            <!-- Phân trang -->
            <nav aria-label="Page navigation" th:if="${monthEventList != null and monthEventList.totalPages > 1}">
                <ul class="pagination m-0">
                    <li class="page-item" th:each="pageNumber : ${pageNumbers}" th:classappend="${currentPage == pageNumber} ? 'active' : ''">
                        <a class="page-link" th:href="@{/home/manager/task(page=${pageNumber},size=${monthEventList.size})}" th:text="${pageNumber}"></a>
                    </li>
                </ul>
            </nav>
            <div th:unless="${monthEventList != null and monthEventList.totalPages > 1}"></div> <!-- Spacer -->

            <!-- Nút trở về -->
            <a th:href="@{/home}" class="btn btn-outline-primary rounded-pill px-4">
                &larr; Trở về trang chủ
            </a>
        </div>

    </div>
</div>

<script th:src="@{/js/bootstrap5.bundle.min.js}"></script>
