<body class="bg-light">
<div class="container-fluid p-0">
    <div th:replace="~{fragments :: header}"></div>
    <nav th:replace="~{fragments :: nav}"></nav>
    
    <div class="container-fluid mt-4 px-3 px-md-4 mb-5">
        
        <!-- Tiêu đề và Nút thêm mới -->
